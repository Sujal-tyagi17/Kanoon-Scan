# Clerk (https://dashboard.clerk.com -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# Optional: Clerk webhook signing secret (Webhooks -> endpoint /api/webhooks/clerk).
# Not required — users are created automatically on first sign-in.
WEBHOOK_SECRET=whsec_xxx

# MongoDB connection string (include the database name)
DATABASE_URL=mongodb+srv://user:pass@cluster.mongodb.net/kanoonscan

# AI providers
GROQ_API_KEY=
GEMINI_API_KEY=

# 32+ character secret used to encrypt document text at rest. Never change it once data exists.
ENCRYPTION_KEY=
